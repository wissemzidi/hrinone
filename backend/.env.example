# Copy this file to .env and fill in what you use. .env is ignored by git.

# AI model (optional: without a key the app uses its rule-based answers)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# HRINONE_MODEL=gemini-flash-latest
# RAG agent: keys starting with "AQ." (Google express mode) use Vertex automatically; override with GEMINI_VERTEX=true/false
# GEMINI_VERTEX=
# HRINONE_RAG_MAX_REWRITES=2

# Security settings (REQUIRED before production deployment)
HRINONE_ENV=development
HRINONE_TOKEN_HOURS=4
HRINONE_COOKIE_SECURE=false
# Comma-separated exact frontend origins; never use * with credentials.
HRINONE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production bootstrap only; choose a unique long password.
HRINONE_ADMIN_EMAIL=
HRINONE_ADMIN_PASSWORD=
